---
import '@fontsource-variable/inter';
import '../styles/global.css';
import LiquidGlassFilter from '../components/LiquidGlassFilter.astro';

interface Props {
  title?: string;
  description?: string;
  /** Slug of the generated OG card, e.g. "home" or "writing-my-post". */
  ogSlug?: string;
  /** Set on blog posts so the page is marked up as an article, not a website. */
  article?: { publishedTime: string; tags?: string[] };
  /** Extra JSON-LD injected by the page (BlogPosting, SoftwareApplication, …). */
  schema?: Record<string, unknown>;
}

const {
  title = 'Reza Bina — Private, on-device apps for iPhone',
  description = 'iOS engineer in Berlin building private, on-device apps that run entirely on your device. Maker of ZumNum and Veil.',
  ogSlug = 'home',
  article,
  schema,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(`/og/${ogSlug}.png`, Astro.site).href;

// Identity graph: one Person, referenced by @id from every page-level entity so
// engines resolve the author to a single entity rather than a repeated string.
const PERSON_ID = new URL('/#person', Astro.site).href;
const person = {
  '@type': 'Person',
  '@id': PERSON_ID,
  name: 'Reza Bina',
  url: Astro.site?.href,
  jobTitle: 'Senior iOS Engineer',
  description:
    'iOS engineer building privacy-first apps that run entirely on the device.',
  address: { '@type': 'PostalAddress', addressLocality: 'Berlin', addressCountry: 'DE' },
  sameAs: [
    'https://github.com/rezabina86',
    'https://www.linkedin.com/in/reza-bina/',
  ],
  knowsAbout: ['iOS development', 'Swift', 'SwiftUI', 'On-device machine learning', 'Privacy engineering'],
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    person,
    {
      '@type': 'WebSite',
      '@id': new URL('/#website', Astro.site).href,
      url: Astro.site?.href,
      name: 'Reza Bina',
      description,
      publisher: { '@id': PERSON_ID },
      inLanguage: 'en',
    },
    ...(schema ? [schema] : []),
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#000000" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Reza Bina" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    {
      article && (
        <>
          <meta property="article:published_time" content={article.publishedTime} />
          <meta property="article:author" content="Reza Bina" />
          {article.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
        </>
      )
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="alternate" type="application/rss+xml" title="Reza Bina — Writing" href="/rss.xml" />

    <!-- is:inline so Astro emits this verbatim instead of treating it as a
         module script to bundle. -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

    <!-- Scroll-reveal starts at opacity:0 and is revealed by JS. Without this
         override a JS-disabled visitor would get a blank page — the content is
         in the HTML, so show it immediately instead. -->
    <noscript>
      <style>
        .reveal { opacity: 1 !important; transform: none !important; }
      </style>
    </noscript>
  </head>
  <body>
    <LiquidGlassFilter />
    <div class="aurora" aria-hidden="true"></div>
    <div class="grain" aria-hidden="true"></div>

    <a class="skip-link" href="#main">Skip to content</a>

    <nav class="nav" aria-label="Main">
      <div class="wrap">
        <a class="brand" href="/"><span class="pip" aria-hidden="true"></span> Reza Bina</a>
        <div class="nav-links">
          <a href="/#apps">Apps</a>
          <a href="/writing">Writing</a>
          <a href="/#about">About</a>
        </div>
      </div>
    </nav>

    <main id="main">
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap">
        <span>© {new Date().getFullYear()} Reza Bina · Berlin</span>
        <span>Built &amp; hosted independently. No trackers.</span>
      </div>
    </footer>

    <script>
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // 1. Reveal on scroll
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.12 }
      );
      document.querySelectorAll('.reveal').forEach((el, i) => {
        (el as HTMLElement).style.transitionDelay = Math.min(i, 7) * 55 + 'ms';
        io.observe(el);
      });

      // 2. Cursor-tracked spotlight on bento cards
      document.querySelectorAll<HTMLElement>('.card').forEach((card) => {
        card.addEventListener('pointermove', (ev) => {
          const r = card.getBoundingClientRect();
          card.style.setProperty('--mx', ev.clientX - r.left + 'px');
          card.style.setProperty('--my', ev.clientY - r.top + 'px');
        });
      });

      // 3. Magnetic buttons (skipped under reduced-motion)
      if (!reduced) {
        document.querySelectorAll<HTMLElement>('.magnetic').forEach((btn) => {
          btn.addEventListener('pointermove', (ev) => {
            const r = btn.getBoundingClientRect();
            const x = ev.clientX - r.left - r.width / 2;
            const y = ev.clientY - r.top - r.height / 2;
            btn.style.transform = `translate(${x * 0.18}px, ${y * 0.28}px)`;
          });
          btn.addEventListener('pointerleave', () => {
            btn.style.transform = '';
          });
        });
      }

      // 4. Condense the glass nav once the page is scrolled
      const nav = document.querySelector('.nav');
      if (nav) {
        const onScroll = () => nav.classList.toggle('condensed', window.scrollY > 8);
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });
      }
    </script>
  </body>
</html>
