---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title?: string;
  description?: string;
  /** Slug of the generated OG card, e.g. "home" or "writing-my-post". */
  ogSlug?: string;
  /** Set on blog posts so the page is marked up as an article, not a website. */
  article?: { publishedTime: string; modifiedTime?: string; tags?: string[] };
  /** Extra JSON-LD injected by the page (BlogPosting, SoftwareApplication,
   *  BreadcrumbList, …). One object, or several to add to the @graph. */
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = 'Reza Bina — Private, on-device apps for iPhone',
  description = 'iOS engineer in Berlin who designs, builds, and ships private, on-device apps end to end — maker of ZumNum and Veil.',
  ogSlug = 'home',
  article,
  schema,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(`/og/${ogSlug}.png`, Astro.site).href;

// Identity graph: one Person, referenced by @id from every page-level entity so
// engines resolve the author to a single entity rather than a repeated string.
const PERSON_ID = new URL('/#person', Astro.site).href;
const person = {
  '@type': 'Person',
  '@id': PERSON_ID,
  name: 'Reza Bina',
  url: Astro.site?.href,
  jobTitle: 'Senior iOS Engineer',
  description:
    'iOS engineer who designs, builds, and ships privacy-first, on-device apps end to end.',
  address: { '@type': 'PostalAddress', addressLocality: 'Berlin', addressCountry: 'DE' },
  sameAs: [
    'https://github.com/rezabina86',
    'https://www.linkedin.com/in/reza-bina/',
  ],
  knowsAbout: [
    'iOS development', 'Swift', 'SwiftUI', 'Swift Concurrency',
    'On-device machine learning', 'Privacy engineering',
    'Indie app development', 'Product design',
  ],
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    person,
    {
      '@type': 'WebSite',
      '@id': new URL('/#website', Astro.site).href,
      url: Astro.site?.href,
      name: 'Reza Bina',
      description,
      publisher: { '@id': PERSON_ID },
      inLanguage: 'en',
    },
    ...(schema ? (Array.isArray(schema) ? schema : [schema]) : []),
  ],
};
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#f7f7f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e1013" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Reza Bina" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    {
      article && (
        <>
          <meta property="article:published_time" content={article.publishedTime} />
          {article.modifiedTime && (
            <meta property="article:modified_time" content={article.modifiedTime} />
          )}
          <meta property="article:author" content="Reza Bina" />
          {article.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
        </>
      )
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="alternate" type="application/rss+xml" title="Reza Bina — Writing" href="/rss.xml" />

    <!-- is:inline so Astro emits this verbatim instead of treating it as a
         module script to bundle. -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <SiteHeader />

    <main id="main">
      <slot />
    </main>

    <SiteFooter />

    {
      /* Cookieless, GDPR-consent-free analytics (GoatCounter): no cookies, no
         personal data, no cross-site tracking — see /privacy. `is:inline` so
         Astro serves the third-party script verbatim instead of bundling it;
         `async` so it never blocks render; gated on PROD so `npm run dev` stays
         out of the stats. Endpoint is the `rezabina` GoatCounter site. */
      import.meta.env.PROD && (
        <script
          is:inline
          data-goatcounter="https://rezabina.goatcounter.com/count"
          async
          src="//gc.zgo.at/count.js"
        />
      )
    }
  </body>
</html>
