---
import { getCollection } from 'astro:content';
import type { CaseStudy } from '../data/caseStudy';
import Row from './Row.astro';
import Section from './Section.astro';
import Prose from './Prose.astro';
import AppStoreBadge from './AppStoreBadge.astro';

/**
 * The case-study page body, shared by every /work/<slug> route. v3 changelog
 * layout: title block → prose summary → one badge (the page's single,
 * fully-compliant badge) → capability rows → stack table → related writing.
 */

interface Props {
  study: CaseStudy;
}

const { study } = Astro.props;

// Storefront-agnostic store URL carries the app id.
const appId = study.appStoreUrl?.match(/id(\d+)/)?.[1];

// Posts that actually mention this app — derived from the content, so the
// list can't rot against a hand-written one.
const related = (await getCollection('blog'))
  .filter((p) => !p.data.draft && (p.body ?? '').includes(study.name))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const iso = (d: Date) => d.toISOString().slice(0, 10);
---

<article class="wrap case">
  <header class="case__head">
    <h1 class="case__name">{study.name.toLowerCase()}</h1>
    <p class="case__meta">
      {study.tagline.toLowerCase().replace(/\.$/, '')}
      {study.shipped && <span> · shipped {study.shipped}</span>}
    </p>
  </header>

  <Section label="what it does" id="what-it-does">
    <Prose>
      <p>{study.summary}</p>
    </Prose>
    {appId && <AppStoreBadge appId={appId} label={study.name} />}
  </Section>

  <Section label="how it works" id="how-it-works">
    {study.features.map((f) => <Row name={f.title} description={f.body} wrap />)}
  </Section>

  <Section label="stack" id="stack">
    <table class="case__stack">
      <thead>
        <tr>
          <th scope="col">built with</th>
        </tr>
      </thead>
      <tbody>
        {study.badges.map((b) => (
          <tr>
            <td>{b}</td>
          </tr>
        ))}
        <tr>
          <td>{study.platform}</td>
        </tr>
      </tbody>
    </table>
  </Section>

  {
    related.length > 0 && (
      <Section label="writing" id="writing">
        {related.map((post) => (
          <Row
            date={iso(post.data.pubDate)}
            name={post.data.tags[0]?.toLowerCase() ?? 'writing'}
            description={post.data.title}
            action="read →"
            actionHref={`/writing/${post.id}`}
          />
        ))}
      </Section>
    )
  }

  {
    study.shots && study.shots.length > 0 && (
      <Section label="screens" id="screens">
        {study.shots.map((shot) => (
          <figure class="case__shot">
            <img src={shot.src} alt={shot.alt} loading="lazy" decoding="async" width="720" height="1565" />
            <figcaption>{shot.caption}</figcaption>
          </figure>
        ))}
      </Section>
    )
  }
</article>

<style>
  .case__head {
    margin-top: 40px;
  }

  .case__name {
    font-size: 14px;
    line-height: 1.7;
    font-weight: 600;
  }

  .case__meta {
    color: var(--ink-2);
  }

  /* The stack is data — a real table in the mono voice. */
  .case__stack {
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }

  .case__stack th {
    font-size: 10.5px;
    line-height: 1;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--ink-2);
    text-align: left;
    padding: 9px 0;
    border-bottom: 1px solid var(--rule-strong);
    min-width: 240px;
  }

  .case__stack td {
    padding: 9px 0;
    border-bottom: 1px solid var(--rule);
  }

  /* Screenshots: plain images at prose width, mono caption, hairline edge. */
  .case__shot {
    max-width: 34rem;
    margin: 0 0 32px;
  }

  .case__shot img {
    width: 100%;
    height: auto;
    border: 1px solid var(--rule);
  }

  .case__shot figcaption {
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--ink-2);
    margin-top: 8px;
  }
</style>
