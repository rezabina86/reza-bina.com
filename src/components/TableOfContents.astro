---
import type { MarkdownHeading } from 'astro';

/**
 * Table of contents, generated from a post's h2/h3. v3: a plain mono list in
 * `--ink-2` — no box, no sticky positioning, no scroll-spy (zero client JS).
 * The h2/h3 hierarchy is carried typographically, not by indent: h2 entries
 * read at full muted strength, h3 entries smaller.
 */

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  items.length > 1 && (
    <nav class="toc" aria-labelledby="toc-heading">
      <p class="toc__title" id="toc-heading">contents</p>
      <ul class="toc__list">
        {items.map((h) => (
          <li class="toc__item">
            <a
              class:list={['toc__link', h.depth === 3 && 'toc__link--sub']}
              href={`#${h.slug}`}
            >
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  .toc {
    margin-top: 32px;
  }

  .toc__title {
    font-size: 10.5px;
    line-height: 1;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-2);
    margin-bottom: 12px;
  }

  .toc__list {
    list-style: none;
    padding: 0;
  }

  .toc__link {
    color: var(--ink-2);
  }

  .toc__link:hover {
    color: var(--accent-hi);
  }

  .toc__link--sub {
    font-size: 12.5px;
  }
</style>
