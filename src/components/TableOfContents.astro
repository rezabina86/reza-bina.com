---
import type { MarkdownHeading } from 'astro';

/**
 * TableOfContents (HANDOFF §7.5) — auto-generated from a post's h2/h3.
 * Rendered statically from Astro's `render()` headings; the only client JS is
 * a small scroll-spy that marks the section currently in view (progressive
 * enhancement — the list is complete and usable without it).
 */

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  items.length > 1 && (
    <nav class="toc" aria-labelledby="toc-heading">
      <p class="toc__title" id="toc-heading">On this page</p>
      <ul class="toc__list">
        {items.map((h) => (
          <li class:list={['toc__item', { 'toc__item--sub': h.depth === 3 }]}>
            <a class="toc__link" href={`#${h.slug}`} data-toc-link={h.slug}>
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<script>
  // Scroll-spy: mark the section currently being read.
  // Position-based rather than IntersectionObserver-band-based: the active item
  // is the last heading above the trigger line, so exactly one item is always
  // active — including past the final heading, where a band-based spy goes blank.
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
  if (links.length) {
    const entries = links
      .map((link) => ({ link, heading: document.getElementById(link.dataset.tocLink!) }))
      .filter((e): e is { link: HTMLAnchorElement; heading: HTMLElement } => e.heading !== null);

    const TRIGGER = 100; // px from viewport top, just below the sticky nav

    let ticking = false;
    const update = () => {
      ticking = false;
      let activeIndex = 0;
      entries.forEach((entry, i) => {
        if (entry.heading.getBoundingClientRect().top <= TRIGGER) activeIndex = i;
      });
      entries.forEach((entry, i) => entry.link.classList.toggle('is-active', i === activeIndex));
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
  }
</script>
