---
/**
 * Contact links above a hairline, then one muted copyright line.
 *
 * The line once carried a "cookieless analytics, no personal data" clause
 * linking /privacy. It was removed in the 2026-09-09 repositioning: an
 * analytics disclosure in the footer was one of four privacy signals that
 * mispositioned the site (decision 0002). GoatCounter still runs and /privacy
 * still exists (indexed, in the sitemap) — it is simply no longer linked from
 * the footer. See CLAUDE.md, "Analytics".
 */
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="site-footer__links">
      <a href="mailto:rezabina.dev@gmail.com">email</a>
      <a href="https://github.com/rezabina86" target="_blank" rel="noopener">github</a>
      <a href="https://www.linkedin.com/in/reza-bina/" target="_blank" rel="noopener">linkedin</a>
      <a href="/rss.xml">rss</a>
    </div>
    <p class="site-footer__meta">
      © {year} Reza Bina · Berlin · built &amp; hosted independently
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 72px;
    padding-bottom: 72px;
  }

  .site-footer__links {
    display: flex;
    gap: 24px;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 8px;
  }

  /* Footer links are chrome: muted, hover to ink. Accent stays in content. */
  .site-footer__links a {
    color: var(--ink-2);
  }

  .site-footer__links a:hover {
    color: var(--ink);
  }

  .site-footer__meta {
    padding-top: 8px;
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--ink-2);
  }

  @media (max-width: 700px) {
    .site-footer {
      margin-top: 56px;
      padding-bottom: 48px; /* specced mobile page padding */
    }
  }
</style>
