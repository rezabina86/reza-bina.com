---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import CaseStudyModal from '../components/CaseStudyModal.tsx';
import { zumnum } from '../data/zumnum';
import { veil } from '../data/veil';
import { readingMinutes } from '../lib/readingTime';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

// Two most recent, so the section shows there is a body of writing rather than a
// single post — and still reads well once there are more.
const recent = posts.slice(0, 2).map((post) => ({
  id: post.id,
  title: post.data.title,
  description: post.data.description,
  pubDate: post.data.pubDate,
  tags: post.data.tags,
  minutes: readingMinutes(post.body),
}));

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' });
---

<Base>
  <div class="home">
    <div class="wrap">

      <!-- 1. Hero band — stands alone, full content width. The entry point. -->
      <header class="card glass glass--refract hero-card reveal">
        <span class="eyebrow"><span class="pip" aria-hidden="true"></span> Senior iOS Engineer</span>
        <h1>
          I build native iOS apps that run entirely <span class="accent">on your device</span>.
        </h1>
        <p class="lede">
          Small, fast, and native — and quietly ambitious under the hood: an
          on-device neural voice instead of a speech API, a local language
          model instead of a server. No accounts, no tracking, nothing leaves
          your phone.
        </p>
        <div class="hero-cta">
          <a class="btn primary magnetic" href="#apps">See the work</a>
          <a class="btn ghost magnetic" href="/writing">Read the writing</a>
        </div>
        <!-- Real claims, not decoration — kept in the a11y tree as a list. -->
        <ul class="hero-stats">
          <li class="stat-pill">100% on-device</li>
          <li class="stat-pill">Zero trackers</li>
          <li class="stat-pill">Works offline</li>
        </ul>
      </header>

      <!-- 2. Apps — the most important content, so it leads. Both apps grouped;
           size carries the hierarchy: ZumNum (shipped) leads, wider and first;
           Veil (in development) is secondary, kept in its amber + dashed state. -->
      <section id="apps" class="home-section reveal" aria-labelledby="apps-heading">
        <div class="section-head">
          <h2 class="section-label" id="apps-heading">Apps</h2>
        </div>
        <div class="apps-grid">
          <!-- ZumNum. The stretched link opens the case study (modal, or the real
               route without JS); the App Store link sits above it via z-index. -->
          <article class="card glass featured card--interactive">
            <span class="card__spot" aria-hidden="true"></span>
            <div class="app-head">
              <img class="icon-img" src="/icons/zumnum.png" width="60" height="60" alt="ZumNum app icon" />
              <h3>ZumNum <span class="tag tag--live">On the App Store</span></h3>
            </div>
            <p>
              Learn German numbers by ear — where the units are said before the
              tens. Hear a number, type what you heard, get instant feedback.
              Fully offline, no ads.
            </p>
            <!-- Badges come from the case-study data so the card, the page and the
                 modal can never disagree about what the app is built with. -->
            <div class="badges" aria-label="Built with">
              {zumnum.badges.map((b) => <span class="badge">{b}</span>)}
              <span class="badge">{zumnum.platform}</span>
            </div>
            <div class="spacer"></div>
            <div class="cta-row">
              <!-- Accessible name must CONTAIN the visible text (WCAG 2.5.3 Label in
                   Name) so voice control can activate it by what's on screen. -->
              <a id="zumnum-trigger" class="link-arrow stretched-link" href="/work/zumnum" aria-label="View case study: ZumNum">View case study →</a>
              <a
                class="link-quiet"
                href="https://apps.apple.com/de/app/zumnum/id6748617262?l=en-GB"
                target="_blank"
                rel="noopener"
              >App Store ↗</a>
            </div>
          </article>

          <!-- Veil — in development. Not on the App Store yet, so the card links
               to its case study rather than a store page. -->
          <article class="card glass featured card--interactive card--wip">
            <span class="card__spot" aria-hidden="true"></span>
            <div class="app-head">
              <!-- 192px source for a 60px slot is deliberate: correct at @3x Retina. -->
              <img class="icon-img" src="/icons/veil.png" width="60" height="60" alt="Veil app icon" loading="lazy" decoding="async" />
              <h3>Veil <span class="tag tag--soon">Coming soon</span></h3>
            </div>
            <p>
              Find and remove the personal details in a document before you share
              it — detected, redacted and stored entirely on your iPhone.
            </p>
            <div class="badges" aria-label="Built with">
              {veil.badges.map((b) => <span class="badge">{b}</span>)}
              <span class="badge">{veil.platform}</span>
            </div>
            <div class="spacer"></div>
            <div class="cta-row">
              <a id="veil-trigger" class="link-arrow stretched-link" href="/work/veil" aria-label="View case study: Veil">View case study →</a>
            </div>
          </article>
        </div>
      </section>

      <!-- 3. Writing — its own section: the two most recent posts, each with
           enough metadata to decide whether to read it. -->
      <section id="writing" class="home-section reveal" aria-labelledby="writing-heading">
        <div class="section-head">
          <h2 class="section-label" id="writing-heading">Writing</h2>
          <a class="link-quiet" href="/writing">All writing →</a>
        </div>
        <div class="card card--soft writing-card">
          <ul class="post-list">
            {recent.map((post) => (
              <li class="post-item">
                <a class="post-item__link" href={`/writing/${post.id}`}>
                  <h3 class="post-item__title">{post.title}</h3>
                </a>
                <p class="post-item__desc">{post.description}</p>
                <p class="post-item__meta">
                  <time datetime={post.pubDate.toISOString()}>{fmt(post.pubDate)}</time>
                  <span aria-hidden="true">·</span>
                  <span>{post.minutes} min read</span>
                  {post.tags.map((tag) => <span class="topic">{tag}</span>)}
                </p>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- 4. About — full-width bio, then a compact Contact strip beneath it
           (single column removes the void a short card left beside the tall bio). -->
      <section id="about" class="home-section reveal" aria-labelledby="about-heading">
        <div class="section-head">
          <h2 class="section-label" id="about-heading">About</h2>
        </div>
        <div class="about-stack">
          <div class="card card--soft about-bio">
            <!-- Employer named contextually, in one clause, at Reza's direction —
                 this supersedes HANDOFF §6's "don't foreground the employer".
                 No years or titles here: the case studies and the writing carry
                 seniority, and the hero already states the role. -->
            <p>
              By day I'm an iOS engineer at Goodnotes. I've been building for iPhone
              since 2015 — ride-hailing, e-commerce, language learning, now
              note-taking — and on evenings and weekends I build privacy-first apps
              of my own, running entirely on the device.
            </p>
            <p>
              An app that never sends your data anywhere cannot misuse it: "we don't
              look at your data" stops being a policy you have to trust and becomes an
              architecture you can check. It also makes the engineering harder in ways
              I enjoy — an on-device neural voice instead of a speech API, a local
              language model and a stack of checksums instead of a server.
            </p>
            <p>
              I came to software from a physics degree, which may explain the taste
              for problems a checksum can settle. I design, build and ship these apps
              myself, including this site.
            </p>
          </div>
          <!-- Compact contact strip: label + icon links on one row, wrapping on
               mobile. Icons are decorative (aria-hidden); the visible text is the
               accessible name. -->
          <div class="card card--soft about-contact">
            <h3 class="eyebrow-sm">Contact</h3>
            <div class="contact">
              <a href="mailto:rezabina.dev@gmail.com">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
                Email
              </a>
              <a href="https://github.com/rezabina86" target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
                GitHub
              </a>
              <a href="https://www.linkedin.com/in/reza-bina/" target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true" focusable="false"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                LinkedIn
              </a>
            </div>
          </div>
        </div>
      </section>

    </div>
  </div>

  <!-- Case-study modal islands (the one React/Framer Motion component; both
       instances share its chunk). Each intercepts its trigger link and
       degrades to the real /work/<slug> route without JS. -->
  <CaseStudyModal client:idle triggerSelector="#zumnum-trigger" study={zumnum} />
  <CaseStudyModal client:idle triggerSelector="#veil-trigger" study={veil} />
</Base>
