---
import Base from '../layouts/Base.astro';
import { Code } from 'astro:components';
import { getCollection } from 'astro:content';
import CaseStudyModal from '../components/CaseStudyModal.tsx';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const latest = posts[0];

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });

// Representative of ZumNum's on-device speech engine (Swift 6 concurrency).
// TODO(reza): confirm or swap for a snippet you'd rather feature.
const snippet = `/// On-device speech: audio is synthesized locally
/// and never leaves the phone.
actor NumberSpeaker {
    private let synthesizer: Synthesizer
    private let player: AudioPlayer

    func speak(
        _ number: Int,
        at rate: SpeechRate = .normal
    ) async throws {
        let phonemes = PhonemeTable.shared[number]
        let audio = try await synthesizer.render(
            phonemes, rate: rate
        )
        try await player.play(audio)
    }
}`;
---

<Base>
  <section class="home">
    <div class="wrap">
      <div class="bento">
        <!-- Hero -->
        <header class="card glass glass--refract hero-card col-7 reveal">
          <span class="eyebrow"><span class="pip" aria-hidden="true"></span> Senior iOS Engineer</span>
          <h1>
            Software that keeps your data <span class="accent">private</span>.
          </h1>
          <p class="lede">
            I build high-quality, privacy-first apps for the Apple ecosystem —
            small, fast, and native, running entirely on your device. No servers,
            no accounts, no tracking.
          </p>
          <div class="hero-cta">
            <a class="btn primary magnetic" href="#apps">See the work</a>
            <a class="btn ghost magnetic" href="/writing">Read the writing</a>
          </div>
          <!-- Real claims, not decoration — kept in the a11y tree as a list. -->
          <ul class="hero-stats">
            <li class="stat-pill">100% on-device</li>
            <li class="stat-pill">Zero trackers</li>
            <li class="stat-pill">Works offline</li>
          </ul>
        </header>

        <!-- Featured app — ZumNum. Stretched primary link → case study route
             (/work/zumnum + modal land in Phase 3); App Store link sits above it. -->
        <article id="apps" class="card glass featured col-5 reveal card--interactive">
          <span class="card__spot" aria-hidden="true"></span>
          <div class="app-head">
            <img class="icon-img" src="/icons/zumnum.png" width="60" height="60" alt="ZumNum app icon" />
            <h2>ZumNum <span class="tag tag--live">On the App Store</span></h2>
          </div>
          <p>
            Learn German numbers by ear. Hear a number, type what you heard, get
            instant feedback — fully offline, no ads. iOS 17+.
          </p>
          <div class="badges" aria-label="Built with">
            <span class="badge">SwiftUI</span>
            <span class="badge">Swift 6 Concurrency</span>
            <span class="badge">On-device speech</span>
            <span class="badge">Fully offline</span>
          </div>
          <div class="spacer"></div>
          <div class="cta-row">
            <!-- Accessible name must CONTAIN the visible text (WCAG 2.5.3 Label in
                 Name) so voice control can activate it by what's on screen. -->
            <a id="zumnum-trigger" class="link-arrow stretched-link" href="/work/zumnum" aria-label="View case study: ZumNum">View case study →</a>
            <a
              class="link-quiet"
              href="https://apps.apple.com/de/app/zumnum/id6748617262?l=en-GB"
              target="_blank"
              rel="noopener"
            >App Store ↗</a>
          </div>
        </article>

        <!-- Blog highlight -->
        {latest && (
          <a class="card card--soft blog-card col-7 reveal" href={`/writing/${latest.id}`}>
            <span class="card__spot" aria-hidden="true"></span>
            <p class="eyebrow-sm">Latest writing</p>
            <h2>{latest.data.title}</h2>
            <p class="desc">{latest.data.description}</p>
            <div class="blog-more">
              <time datetime={latest.data.pubDate.toISOString()}>{fmt(latest.data.pubDate)}</time>
            </div>
          </a>
        )}

        <!-- Live Swift snippet -->
        <div class="card card--soft snippet-card col-5 reveal">
          <div class="snippet-head">
            <span class="dots" aria-hidden="true"><span class="dot"></span><span class="dot"></span><span class="dot"></span></span>
            <span class="file">NumberSpeaker.swift</span>
          </div>
          <Code code={snippet} lang="swift" theme="github-dark-default" />
          <p class="snippet-note">Actor-isolated speech synthesis — audio never leaves the device.</p>
        </div>

        <!-- About -->
        <section id="about" class="card card--soft col-4 reveal">
          <p class="eyebrow-sm">About</p>
          <p>
            I'm a Senior iOS Engineer building a small portfolio of privacy-first,
            on-device apps. I believe the best software is quiet, fast, and
            trustworthy — respecting people's data isn't a feature, it's the default.
          </p>
        </section>

        <!-- Veil — coming soon (link target TBD with Reza; non-clickable for now) -->
        <section class="card card--soft col-4 reveal" aria-label="Veil — coming soon">
          <div class="app-head">
            <!-- 192px source for a 60px slot is deliberate: correct at @3x Retina. -->
            <img class="icon-img" src="/icons/veil.png" width="60" height="60" alt="Veil app icon" loading="lazy" decoding="async" />
            <h2>Veil <span class="tag tag--soon">Coming soon</span></h2>
          </div>
          <p>
            On-device document redaction — hide names, numbers, and faces before
            you share. Nothing is uploaded; nothing leaves your iPhone.
          </p>
        </section>

        <!-- Contact -->
        <section class="card card--soft col-4 reveal">
          <p class="eyebrow-sm">Elsewhere</p>
          <div class="contact">
            <a href="mailto:rezabina.dev@gmail.com">Email</a>
            <a href="https://github.com/rezabina86" target="_blank" rel="noopener">GitHub</a>
            <a href="https://www.linkedin.com/in/reza-bina/" target="_blank" rel="noopener">LinkedIn</a>
            <a href="https://x.com/rezabina86" target="_blank" rel="noopener">X</a>
          </div>
        </section>
      </div>
    </div>
  </section>

  <!-- Case-study modal island (the one React/Framer Motion island).
       Intercepts #zumnum-trigger; degrades to the /work/zumnum route. -->
  <CaseStudyModal client:idle triggerSelector="#zumnum-trigger" />
</Base>
