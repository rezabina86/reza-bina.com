---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import Row from '../components/Row.astro';
import Section from '../components/Section.astro';
import AppStoreBadge from '../components/AppStoreBadge.astro';

// Every published post, newest first — the rows come from the collection so
// the list can never rot against the actual content.
const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const iso = (d: Date) => d.toISOString().slice(0, 10);
---

<Base pageMax="54rem">
  <div class="wrap">
    <!-- The SiteHeader is the homepage's title block; content starts at #apps.
         The #apps / #writing / #about ids are nav anchors — preserve them. -->
    <Section label="apps" id="apps">
      <Row
        date="2026-08-07"
        name="Veil"
        href="/work/veil"
        description="Find and remove the personal details in a document before you share it — entirely on the iPhone."
      >
        <AppStoreBadge slot="action" appId="6780531974" label="Veil" />
      </Row>
      <Row
        date="2025-08-01"
        name="ZumNum"
        href="/work/zumnum"
        description="Learn German numbers by ear — hear one, type what you heard. Fully offline, no ads."
      >
        <AppStoreBadge slot="action" appId="6748617262" label="ZumNum" />
      </Row>
    </Section>

    <Section label="writing" id="writing">
      {
        posts.map((post) => (
          <Row
            date={iso(post.data.pubDate)}
            name={post.data.tags[0]?.toLowerCase() ?? 'writing'}
            description={post.data.title}
            action="read →"
            actionHref={`/writing/${post.id}`}
          />
        ))
      }
    </Section>

    <Section label="about" id="about">
      <Row
        name="now"
        description="iOS engineer at Goodnotes; evenings and weekends on my own privacy-first apps."
      />
      <Row
        name="before"
        description="Building for iPhone since 2015 — ride-hailing, e-commerce, language learning. A physics degree before that."
      />
    </Section>
  </div>
</Base>
