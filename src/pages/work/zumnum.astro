---
import Base from '../../layouts/Base.astro';
import CaseStudyPage from '../../components/CaseStudyPage.astro';
import { zumnum } from '../../data/zumnum';

const title = `${zumnum.name} — ${zumnum.tagline} · Reza Bina`;
const description = zumnum.summary;

const canonical = new URL('/work/zumnum/', Astro.site).href;
const app = {
  '@type': 'SoftwareApplication',
  '@id': `${canonical}#app`,
  name: zumnum.name,
  description: zumnum.summary,
  applicationCategory: 'MobileApplication',
  operatingSystem: zumnum.platform,
  author: { '@id': new URL('/#person', Astro.site).href },
  image: new URL('/og/work-zumnum.png', Astro.site).href,
  ...(zumnum.appStoreUrl ? { installUrl: zumnum.appStoreUrl } : {}),
};

const site = Astro.site!.href;
const breadcrumb = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site },
    { '@type': 'ListItem', position: 2, name: 'Apps', item: `${site}#apps` },
    { '@type': 'ListItem', position: 3, name: zumnum.name },
  ],
};
---

<Base title={title} description={description} ogSlug="work-zumnum" schema={[app, breadcrumb]}>
  <CaseStudyPage study={zumnum} />
</Base>
