---
import Base from '../layouts/Base.astro';

// GitHub Pages serves this as the 404.html for any unknown path (with a real
// 404 status), so it needs no noindex machinery.
---

<Base
  title="Page not found — Reza Bina"
  description="That page doesn't exist. Head back to the home page or browse the writing."
  pageMax="42rem"
>
  <section class="wrap notfound">
    <h1 class="notfound__title">404 — no such path</h1>
    <p class="notfound__lede">The paths that do exist:</p>
    <ul class="notfound__paths">
      <li><a href="/">/</a></li>
      <li><a href="/work/veil">/work/veil</a></li>
      <li><a href="/work/zumnum">/work/zumnum</a></li>
      <li><a href="/writing">/writing</a></li>
      <li><a href="/privacy">/privacy</a></li>
      <li><a href="/rss.xml">/rss.xml</a></li>
    </ul>
  </section>
</Base>

<style>
  .notfound {
    margin-top: 40px;
  }

  .notfound__title {
    font-size: 14px;
    line-height: 1.7;
    font-weight: 600;
  }

  .notfound__lede {
    color: var(--ink-2);
  }

  .notfound__paths {
    list-style: none;
    padding: 0;
    margin-top: 16px;
  }

  .notfound__paths li {
    border-top: 1px solid var(--rule);
    padding: 9px 0;
  }
</style>
