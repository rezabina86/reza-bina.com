---
import Base from '../../layouts/Base.astro';
import Row from '../../components/Row.astro';
import { getCollection } from 'astro:content';

// Drafts are excluded at build time, not hidden with CSS.
const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const iso = (d: Date) => d.toISOString().slice(0, 10);
const tags = (list: string[]) => list.map((t) => `[${t.toLowerCase()}]`).join(' ');
---

<Base
  title="Writing — Reza Bina"
  description="Essays on privacy, on-device software, and building independent iOS apps."
  ogSlug="writing"
>
  <div class="wrap writing-index">
    <h1 class="writing-index__title"><span aria-hidden="true"># </span>writing</h1>
    <!-- The index is the same Row as everywhere else — no separate table shape.
         date | title | read → on line one, tags on line two. -->
    {
      posts.map((post) => (
        <Row
          date={iso(post.data.pubDate)}
          name={post.data.title}
          href={`/writing/${post.id}`}
          description={tags(post.data.tags)}
          action="read →"
          actionHref={`/writing/${post.id}`}
        />
      ))
    }
  </div>
</Base>

<style>
  .writing-index {
    margin-top: 40px;
  }

  .writing-index__title {
    font-size: 14px;
    line-height: 1.7;
    font-weight: 400;
    color: var(--ink-2);
    margin-bottom: 10px;
  }
</style>
