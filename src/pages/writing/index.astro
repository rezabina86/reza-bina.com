---
import Base from '../../layouts/Base.astro';
import Row from '../../components/Row.astro';
import { getCollection } from 'astro:content';

// Drafts are excluded at build time, not hidden with CSS.
const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const iso = (d: Date) => d.toISOString().slice(0, 10);
// Tags render as written in frontmatter — casing is content's business.
const tags = (list: string[]) => list.map((t) => `[${t}]`).join(' ');
---

<Base
  title="Writing — Reza Bina"
  description="Essays on privacy, on-device software, and building independent iOS apps."
  ogSlug="writing"
>
  <div class="wrap writing-index">
    <!-- The # marker means "section"; a page title doesn't carry it. -->
    <div class="writing-index__head">
      <h1 class="writing-index__title">writing</h1>
      <a class="writing-index__rss" href="/rss.xml">rss →</a>
    </div>
    <!-- The index is the same Row as everywhere else — no separate table shape.
         date | title | read → on line one, tags on line two. -->
    {
      posts.map((post) => (
        <Row
          date={iso(post.data.pubDate)}
          name={post.data.title}
          href={`/writing/${post.id}`}
          description={tags(post.data.tags)}
          action="read →"
          actionHref={`/writing/${post.id}`}
        />
      ))
    }
  </div>
</Base>

<style>
  .writing-index {
    /* A page title is a bigger event than a section: 56, not 40. */
    margin-top: 56px;
  }

  .writing-index__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 12px;
  }

  /* A page title: weight and colour, not a section label. */
  .writing-index__title {
    font-size: 14px;
    line-height: 1.7;
    font-weight: 600;
    color: var(--ink);
  }

  .writing-index__rss {
    text-decoration: underline;
    text-decoration-color: var(--rule-strong);
    text-underline-offset: 0.15em;
  }

  .writing-index__rss:hover {
    text-decoration-color: currentColor;
  }
</style>
