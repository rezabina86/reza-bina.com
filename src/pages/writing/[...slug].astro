---
import Base from '../../layouts/Base.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { getCollection, render } from 'astro:content';
import { readingMinutes } from '../../lib/readingTime';

export async function getStaticPaths() {
  // Drafts are readable with `npm run dev` but never get a production URL.
  // Filtering only the index would still publish a reachable page — `draft`
  // has to mean unpublished, not merely unlisted.
  const posts = await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });

const minutes = readingMinutes(post.body);

const canonical = new URL(`/writing/${post.id}/`, Astro.site).href;
const blogPosting = {
  '@type': 'BlogPosting',
  '@id': `${canonical}#article`,
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updated ?? post.data.pubDate).toISOString(),
  author: { '@id': new URL('/#person', Astro.site).href },
  publisher: { '@id': new URL('/#person', Astro.site).href },
  mainEntityOfPage: canonical,
  image: new URL(`/og/writing-${post.id}.png`, Astro.site).href,
  keywords: post.data.tags.join(', '),
  wordCount: post.body?.trim().split(/\s+/).filter(Boolean).length ?? 0,
  inLanguage: 'en',
};

const site = Astro.site!.href;
const breadcrumb = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site },
    { '@type': 'ListItem', position: 2, name: 'Writing', item: `${site}writing/` },
    { '@type': 'ListItem', position: 3, name: post.data.title },
  ],
};
---

<Base
  title={`${post.data.title} — Reza Bina`}
  description={post.data.description}
  ogSlug={`writing-${post.id}`}
  article={{
    publishedTime: post.data.pubDate.toISOString(),
    modifiedTime: post.data.updated?.toISOString(),
    tags: post.data.tags,
  }}
  schema={[blogPosting, breadcrumb]}
>
  <article class="article">
    <div class="wrap">
      <a class="back" href="/writing">← Writing</a>
      <h1>{post.data.title}</h1>
      <p class="meta">
        <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
        <span class="meta__dot" aria-hidden="true">·</span>
        <span>{minutes} min read</span>
        {post.data.updated && (
          <>
            <span class="meta__dot" aria-hidden="true">·</span>
            <span>Updated <time datetime={post.data.updated.toISOString()}>{fmt(post.data.updated)}</time></span>
          </>
        )}
      </p>

      <div class="article__layout">
        <aside class="article__aside">
          <TableOfContents headings={headings} />
        </aside>

        <div class="prose">
          <Content />
        </div>
      </div>
    </div>
  </article>
</Base>
