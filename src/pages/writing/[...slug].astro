---
import Base from '../../layouts/Base.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import Prose from '../../components/Prose.astro';
import Row from '../../components/Row.astro';
import { getCollection, render } from 'astro:content';
import { readingMinutes } from '../../lib/readingTime';

export async function getStaticPaths() {
  // Drafts are readable with `npm run dev` but never get a production URL.
  // Filtering only the index would still publish a reachable page — `draft`
  // has to mean unpublished, not merely unlisted.
  const posts = await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const iso = (d: Date) => d.toISOString().slice(0, 10);
const minutes = readingMinutes(post.body);

// Prev/next across the published posts, newest first (prev = newer).
const published = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const index = published.findIndex((p) => p.id === post.id);
const newer = index > 0 ? published[index - 1] : undefined;
const older = index >= 0 && index < published.length - 1 ? published[index + 1] : undefined;

const canonical = new URL(`/writing/${post.id}/`, Astro.site).href;
const blogPosting = {
  '@type': 'BlogPosting',
  '@id': `${canonical}#article`,
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updated ?? post.data.pubDate).toISOString(),
  author: { '@id': new URL('/#person', Astro.site).href },
  publisher: { '@id': new URL('/#person', Astro.site).href },
  mainEntityOfPage: canonical,
  image: new URL(`/og/writing-${post.id}.png`, Astro.site).href,
  keywords: post.data.tags.join(', '),
  wordCount: post.body?.trim().split(/\s+/).filter(Boolean).length ?? 0,
  inLanguage: 'en',
};

const site = Astro.site!.href;
const breadcrumb = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site },
    { '@type': 'ListItem', position: 2, name: 'Writing', item: `${site}writing/` },
    { '@type': 'ListItem', position: 3, name: post.data.title },
  ],
};
---

<Base
  title={`${post.data.title} — Reza Bina`}
  description={post.data.description}
  ogSlug={`writing-${post.id}`}
  article={{
    publishedTime: post.data.pubDate.toISOString(),
    modifiedTime: post.data.updated?.toISOString(),
    tags: post.data.tags,
  }}
  schema={[blogPosting, breadcrumb]}
>
  <article class="wrap article">
    <!-- Mono header block at prose width — the title is not a display size. -->
    <header class="article__head">
      <h1 class="article__title">{post.data.title}</h1>
      <p class="article__meta">
        <time datetime={post.data.pubDate.toISOString()}>{iso(post.data.pubDate)}</time>
        {
          post.data.updated && (
            <>
              {' · updated '}
              <time datetime={post.data.updated.toISOString()}>{iso(post.data.updated)}</time>
            </>
          )
        }
        {` · ${minutes} min · `}
        {post.data.tags.map((t) => `[${t.toLowerCase()}]`).join(' ')}
      </p>
    </header>

    <TableOfContents headings={headings} />

    <div class="article__body">
      <Prose>
        <Content />
      </Prose>
    </div>

    <footer class="article__foot">
      {
        newer && (
          <Row
            date={iso(newer.data.pubDate)}
            name="newer"
            description={newer.data.title}
            action="read →"
            actionHref={`/writing/${newer.id}`}
          />
        )
      }
      {
        older && (
          <Row
            date={iso(older.data.pubDate)}
            name="older"
            description={older.data.title}
            action="read →"
            actionHref={`/writing/${older.id}`}
          />
        )
      }
    </footer>
  </article>
</Base>

<style>
  .article {
    margin-top: 40px;
  }

  .article__title {
    font-size: 14px;
    line-height: 1.7;
    font-weight: 600;
  }

  .article__meta {
    color: var(--ink-2);
    font-size: 12.5px;
    line-height: 1.6;
  }

  .article__body {
    margin-top: 32px;
  }

  .article__foot {
    margin-top: 56px;
  }
</style>
