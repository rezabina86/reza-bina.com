---
import Base from '../../layouts/Base.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });

// Reading time from the raw body (~200 wpm), rounded up to a whole minute.
const words = post.body?.trim().split(/\s+/).length ?? 0;
const readingMinutes = Math.max(1, Math.ceil(words / 200));
---

<Base title={`${post.data.title} — Reza Bina`} description={post.data.description}>
  <article class="article">
    <div class="wrap">
      <a class="back" href="/writing">← Writing</a>
      <h1>{post.data.title}</h1>
      <p class="meta">
        <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
        <span class="meta__dot" aria-hidden="true">·</span>
        <span>{readingMinutes} min read</span>
      </p>

      <div class="article__layout">
        <aside class="article__aside">
          <TableOfContents headings={headings} />
        </aside>

        <div class="prose">
          <Content />
        </div>
      </div>
    </div>
  </article>
</Base>
