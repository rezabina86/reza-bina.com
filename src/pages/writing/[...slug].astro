---
import Base from '../../layouts/Base.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import Prose from '../../components/Prose.astro';
import Row from '../../components/Row.astro';
import AppStoreBadge from '../../components/AppStoreBadge.astro';
import SubscribeForm from '../../components/SubscribeForm.astro';
import { getCollection, render } from 'astro:content';
import { readingMinutes } from '../../lib/readingTime';
import { veil } from '../../data/veil';
import { zumnum } from '../../data/zumnum';

export async function getStaticPaths() {
  // Drafts are readable with `npm run dev` but never get a production URL.
  // Filtering only the index would still publish a reachable page — `draft`
  // has to mean unpublished, not merely unlisted.
  const posts = await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const iso = (d: Date) => d.toISOString().slice(0, 10);
const minutes = readingMinutes(post.body);

// Prev/next across the published posts, newest first (prev = newer).
const published = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const index = published.findIndex((p) => p.id === post.id);
const newer = index > 0 ? published[index - 1] : undefined;
const older = index >= 0 && index < published.length - 1 ? published[index + 1] : undefined;

// The app this article is about — the article's one path to the store.
// Derived from mentions in the body (the same match CaseStudyPage uses for
// related posts) so it cannot rot; when both apps appear, the most-mentioned
// one is the subject, keeping the page at Apple's one badge per layout.
const mentions = (name: string) => (post.body ?? '').split(name).length - 1;
const subject = [veil, zumnum]
  .map((app) => ({ app, n: mentions(app.name) }))
  .filter((x) => x.n > 0)
  .sort((a, b) => b.n - a.n)[0]?.app;
const subjectAppId = subject?.appStoreUrl?.match(/id(\d+)/)?.[1];

const canonical = new URL(`/writing/${post.id}/`, Astro.site).href;
const blogPosting = {
  '@type': 'BlogPosting',
  '@id': `${canonical}#article`,
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updated ?? post.data.pubDate).toISOString(),
  author: { '@id': new URL('/#person', Astro.site).href },
  publisher: { '@id': new URL('/#person', Astro.site).href },
  mainEntityOfPage: canonical,
  image: new URL(`/og/writing-${post.id}.png`, Astro.site).href,
  keywords: post.data.tags.join(', '),
  wordCount: post.body?.trim().split(/\s+/).filter(Boolean).length ?? 0,
  inLanguage: 'en',
};

const site = Astro.site!.href;
const breadcrumb = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site },
    { '@type': 'ListItem', position: 2, name: 'Writing', item: `${site}writing/` },
    { '@type': 'ListItem', position: 3, name: post.data.title },
  ],
};
---

<Base
  title={`${post.data.title} — Reza Bina`}
  description={post.data.description}
  ogSlug={`writing-${post.id}`}
  article={{
    publishedTime: post.data.pubDate.toISOString(),
    modifiedTime: post.data.updated?.toISOString(),
    tags: post.data.tags,
  }}
  schema={[blogPosting, breadcrumb]}
>
  <article class="wrap article">
    <!-- Mono header block at prose width — the title is not a display size. -->
    <header class="article__head">
      <h1 class="article__title">{post.data.title}</h1>
      <p class="article__meta">
        <time datetime={post.data.pubDate.toISOString()}>{iso(post.data.pubDate)}</time>
        {
          post.data.updated && (
            <>
              {' · updated '}
              <time datetime={post.data.updated.toISOString()}>{iso(post.data.updated)}</time>
            </>
          )
        }
        {` · ${minutes} min · `}
        {post.data.tags.map((t) => `[${t}]`).join(' ')}
      </p>
    </header>

    <TableOfContents headings={headings} />

    <div class="article__body">
      <Prose>
        <Content />
      </Prose>
    </div>

    <footer class="article__foot">
      {
        subject && subjectAppId && (
          <div class="article__app">
            <Row
              date={subject.shipped}
              name={subject.name}
              href={`/work/${subject.slug}`}
              description={subject.tagline}
            >
              <AppStoreBadge slot="action" appId={subjectAppId} label={subject.name} />
            </Row>
          </div>
        )
      }
      <!-- newer/older are signposts, not content: they take the label slot;
           the next article's title carries the emphasis. -->
      {
        newer && (
          <Row
            date="newer"
            name={newer.data.title}
            href={`/writing/${newer.id}`}
            action="read →"
            actionHref={`/writing/${newer.id}`}
          />
        )
      }
      {
        older && (
          <Row
            date="older"
            name={older.data.title}
            href={`/writing/${older.id}`}
            action="read →"
            actionHref={`/writing/${older.id}`}
          />
        )
      }
      <SubscribeForm />
    </footer>
  </article>
</Base>

<style>
  .article {
    /* A page title is a bigger event than a section: 56, not 40. */
    margin-top: 56px;
  }

  .article__title {
    font-size: 14px;
    line-height: 1.7;
    font-weight: 600;
  }

  .article__meta {
    color: var(--ink-2);
    font-size: 12.5px;
    line-height: 1.6;
  }

  .article__body {
    margin-top: 32px;
  }

  .article__foot {
    margin-top: 56px;
  }

  /* The way to get the app stands apart from the prev/next list. */
  .article__app {
    margin-bottom: 32px;
  }
</style>
